  "de": {
    "title": "Kürbissuppe mit Hokkaido",
    "steps": [
      "Den Hokkaido waschen, entkernen und in Stücke schneiden (die Schale kann dranbleiben). Zwiebel und Knoblauch schälen und hacken.",
      "Butter im Topf zerlassen und Zwiebel, Knoblauch und Kürbis darin einige Minuten anbraten.",
      "Brühe angießen, aufkochen und etwa 15 Minuten garen, bis der Kürbis weich ist.",
      "Die Suppe fein pürieren, die Sahne einrühren und mit Salz und Pfeffer würzen.",
      "Mit Petersilie und einer Prise Chiliflocken bestreuen (für Kinder die Flocken weglassen)."
    ]
  },
  "en": {
    "title": "Hokkaido pumpkin soup",
    "steps": [
      "Wash and deseed the Hokkaido pumpkin and cut it into chunks (the skin can stay on). Peel and chop the onion and garlic.",
      "Melt the butter in a pot and fry the onion, garlic and pumpkin for a few minutes.",
      "Pour in the stock, bring to the boil and cook for about 15 minutes until the pumpkin is soft.",
      "Blend the soup until smooth, stir in the cream and season with salt and pepper.",
      "Sprinkle with parsley and a pinch of chili flakes (leave the flakes out for children)."
    ],
