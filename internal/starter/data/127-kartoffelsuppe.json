  "de": {
    "title": "Kartoffelsuppe mit Würstchen",
    "steps": [
      "Zwiebel, 4 Möhren, 700 g Kartoffeln und 1 Stange Lauch putzen und würfeln bzw. schneiden. 100 g Speck würfeln.",
      "2 EL Öl im großen Topf erhitzen, den Speck darin auslassen.",
      "Zwiebel zugeben und glasig dünsten.",
      "Das restliche Gemüse zugeben und mit 1 Liter Brühe auffüllen, sodass alles bedeckt ist. 2 Lorbeerblätter und 2 Nelken hineingeben.",
      "Etwa 30 Minuten köcheln lassen.",
      "Lorbeer und Nelken herausfischen, erst danach würzen: gehackte Petersilie, Majoran, Thymian, Salz und Pfeffer.",
      "4 Wiener Würstchen in Scheiben schneiden und ganz zum Schluss in der Suppe erwärmen.",
      "Mit Crème fraîche servieren. Die Suppe schmeckt auch aufgewärmt sehr gut."
    ]
  },
  "en": {
    "title": "Potato soup with sausages",
    "steps": [
      "Clean and dice the onion, 4 carrots, 700 g potatoes and 1 leek. Dice 100 g bacon.",
      "Heat 2 tbsp oil in a large pot and render the bacon in it.",
      "Add the onion and sweat until glassy.",
      "Add the remaining vegetables and pour in 1 litre stock so everything is covered. Add 2 bay leaves and 2 cloves.",
      "Simmer about 30 minutes.",
      "Fish out the bay and cloves, and only then season: chopped parsley, marjoram, thyme, salt and pepper.",
      "Slice 4 Vienna sausages and warm them in the soup at the very end.",
      "Serve with crème fraîche. The soup also tastes great reheated."
    ],
