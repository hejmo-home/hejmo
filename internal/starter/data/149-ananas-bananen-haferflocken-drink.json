  "en": {
    "title": "Pineapple-banana-oat drink",
    "steps": [
      "Peel the pineapple, quarter it lengthways and remove the hard core. Dice the flesh.",
      "Slice the bananas and mix them with the lemon juice straight away so they do not turn brown.",
      "Peel the ginger and dice it finely.",
      "Blend the pineapple, bananas, ginger and apple juice in a blender until smooth.",
      "Pour into glasses and sprinkle with the oats and a pinch of nutmeg."
