  "de": {
    "title": "Linsensuppe (vegan)",
    "steps": [
      "3 Zwiebeln, 4 Kartoffeln, 2 Möhren und 250 g Räuchertofu würfeln.",
      "Olivenöl in einem großen Topf erhitzen. Zwiebeln und Tofu darin anbraten.",
      "Kartoffeln und Möhren zugeben und mitbraten, bis das Gemüse Farbe nimmt.",
      "Reichlich Tomatenmark (etwa 1/2 Tube) einrühren und kurz anrösten, bevor die Flüssigkeit kommt.",
      "1 Liter Gemüsebrühe und 1 Liter Wasser angießen, 250 g Tellerlinsen zugeben.",
      "Etwa 1 Stunde köcheln lassen.",
      "Erst jetzt würzen: Brühepulver, Balsamico, Salz, Pfeffer, Zucker und gehackte Petersilie nach Geschmack."
    ]
  },
  "en": {
    "title": "Lentil soup (vegan)",
    "steps": [
      "Dice 3 onions, 4 potatoes, 2 carrots and 250 g smoked tofu.",
      "Heat olive oil in a large pot. Fry the onions and tofu in it.",
      "Add the potatoes and carrots and fry until the vegetables take on colour.",
      "Stir in plenty of tomato paste (about 1/2 tube) and fry briefly before adding any liquid.",
      "Pour in 1 litre vegetable stock and 1 litre water, add 250 g brown lentils.",
      "Simmer about 1 hour.",
      "Season only now: stock powder, balsamic vinegar, salt, pepper, sugar and chopped parsley to taste."
    ],
